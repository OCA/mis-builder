<odoo>
    <record id="mis_budget_by_account_form_view" model="ir.ui.view">
        <field name="name">mis.budget.by.account.form (in mis_builder_budget)</field>
        <field name="model">mis.budget.by.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_draft"
                        string="Set draft"
                        type="object"
                        invisible="state == 'draft'"
                    />
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state == 'cancelled'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(mis_budget_by_account_item_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            icon="menu"
                            string="Budget items"
                        />
                    </div>
                    <group>
                        <field name="name" />
                        <field name="active" invisible="True" />
                        <field name="description" />
                        <field
                            name="company_id"
                            readonly="1"
                            groups="base.group_multi_company"
                        />
                    </group>
                    <group>
                        <field name="date_range_id" />
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="allow_items_overlap" />
                    </group>
                </sheet>
                <!-- Chatter -->
                <chatter />
            </form>
        </field>
    </record>
    <record id="mis_budget_by_account_search_view" model="ir.ui.view">
        <field name="name">mis.budget.by.account.search (in mis_builder_budget)</field>
        <field name="model">mis.budget.by.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state" />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>
    <record id="mis_budget_by_account_list_view" model="ir.ui.view">
        <field name="name">mis.budget.by.account.list (in mis_builder_budget)</field>
        <field name="model">mis.budget.by.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record id="mis_budget_by_account_act_window" model="ir.actions.act_window">
        <field name="name">MIS Budgets (by accounts)</field>
        <field name="res_model">mis.budget.by.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="path">mis-budgets-by-account</field>
    </record>
    <record id="mis_budget_by_account_menu" model="ir.ui.menu">
        <field name="name">MIS Budgets (by accounts)</field>
        <field name="parent_id" ref="mis_builder.mis_report_finance_menu" />
        <field name="action" ref="mis_budget_by_account_act_window" />
        <field name="sequence" eval="201" />
    </record>
</odoo>
