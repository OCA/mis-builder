<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_read_annotation" model="res.groups">
        <field name="name">MIS Report: view annotations</field>
    </record>
    <record id="group_edit_annotation" model="res.groups">
        <field name="name">MIS Report: add annotations</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('mis_builder.group_read_annotation'))]"
        />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
</odoo>
