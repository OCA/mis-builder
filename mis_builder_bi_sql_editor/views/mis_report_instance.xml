<odoo>

    <record model="ir.ui.view" id="mis_report_instance_period_view_form">
        <field
            name="name"
        >mis.report.instance.period.form (in mis_builder_bi_sql_editor)</field>
        <field name="model">mis.report.instance.period</field>
        <field
            name="inherit_id"
            ref="mis_builder.mis_report_instance_period_view_form"
        />
        <field name="arch" type="xml">
            <field name="source_aml_model_id" position="after">
                <field name="bi_sql_view_required" invisible="1" />
                <field
                    name="bi_sql_view"
                    attrs="{'required': [('bi_sql_view_required', '=', True)], 'invisible': [('bi_sql_view_required', '=', False)]}"
                />
            </field>
        </field>
    </record>

</odoo>
