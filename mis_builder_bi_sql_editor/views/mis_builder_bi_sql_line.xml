<odoo>

    <record id="view_mis_builder_bi_sql_line_form" model="ir.ui.view">
        <field name="name">mis.builder.bi.sql.line.form</field>
        <field name="model">mis.builder.bi.sql.line</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <group>
                    <group>
                        <field name="credit" />
                        <field name="debit" />
                        <field name="date" />
                    </group>
                    <group>
                        <field name="account_id" />
                        <field name="company_id" />
                        <field name="analytic_account_id" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_mis_builder_bi_sql_line_tree" model="ir.ui.view">
        <field name="name">mis.builder.bi.sql.line.tree</field>
        <field name="model">mis.builder.bi.sql.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="company_id" />
                <field name="account_id" />
                <field name="credit" />
                <field name="debit" />
                <field name="date" />
                <field name="analytic_account_id" />
            </tree>
        </field>
    </record>

</odoo>
